 = -150\r\n            mySprite.sayText(\"Owee my ankle\", 1000)\r\n        })\r\n    } else if (mySprite.isHittingTile(CollisionDirection.Right)) {\r\n        timer.throttle(\"action\", 1000, function () {\r\n            mySprite.vx = -150\r\n            mySprite.vy = -150\r\n            mySprite.sayText(\"Owee my ankle\", 1000)\r\n        })\r\n    }\r\n})\r\n\r\ngame.splash('Burger Jumper 2000', 'Yes a burger jumps.')\r\ninfo.startCountdown(30)\r\ninfo.onCountdownEnd(function(){\r\n    game.gameOver(false)\r\n})\r\n\r\nscroller.setLayerImage(1 ,assets.image`myImage`)\r\nscroller.scrollBackgroundWithSpeed(20, 0, 1)\r\nscroller.setBackgroundScrollOffset(0, 0)","README.md":" ","assets.json":"","images.g.jres":"{\n    \"image1\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"smallBurgerMINE\"\n    },\n    \"image2\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"pedestal\"\n    },\n    \"image3\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"myImage\"\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myImages\"\n    }\n}","images.g.ts":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"tile1\": {\n        \"data\": \"hwQQABAAAACZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmQ==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"myTile\"\n    },\n    \"tile3\": {\